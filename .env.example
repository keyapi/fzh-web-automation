# fzh-web-automation 环境变量模板
# 复制为 .env 后填入实际值（.env 已被 .gitignore 排除）

# --- 通途 ERP ---
# ddddocr 自动登录需要
TONGTU_USER=your-email@example.com
TONGTU_PASSWORD=your-password

# --- 赛狐 ERP ---
# ddddocr 自动登录需要
SELLFOX_USER=your-username
SELLFOX_PASSWORD=your-password

# --- Playwright ---
# 浏览器默认使用 persistent_context，无需额外配置
# MCP 模式使用独立浏览器实例
